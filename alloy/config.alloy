// Central Alloy receives OTLP from applications or remote Alloy agents.
otelcol.receiver.otlp "central" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.central.input]
    logs    = [otelcol.processor.batch.central.input]
    traces  = [otelcol.processor.batch.central.input]
  }
}

otelcol.processor.batch "central" {
  output {
    metrics = [otelcol.exporter.prometheus.central.input]
    logs    = [otelcol.exporter.loki.central.input]
    traces  = [otelcol.exporter.otlp.central.input]
  }
}

otelcol.exporter.loki "central" {
  forward_to = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.prometheus "central" {
  forward_to = [prometheus.remote_write.central.receiver]
}

prometheus.remote_write "central" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

otelcol.exporter.otlp "central" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
